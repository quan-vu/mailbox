# Demo API binds only to loopback by default. Do not expose publicly.
MAILBOX_BIND=127.0.0.1:3000
RUST_LOG=info
# Future production configuration (NOT USED in the demo starter):
# MAILBOX_DATABASE_URL=postgres://mailbox:...@127.0.0.1:5432/mailbox
# MAILBOX_MASTER_KEY=DO_NOT_COMMIT_OR_LOG
# Browser origins allowed to read the demo API (loopback http only; others are ignored).
MAILBOX_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Build-time API origin for the Web UI (cargo/dx environment, not read at runtime).
# MAILBOX_API_URL=http://127.0.0.1:3000
